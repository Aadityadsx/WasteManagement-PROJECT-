<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Waste Management System</title>

    @Styles.Render("~/Content/css")

    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f0fdf4;
            font-family: Arial, Helvetica, sans-serif;
            color: #1f2937;
        }

        /* NAVBAR */
        .eco-navbar {
            background: linear-gradient(135deg, #14532d, #15803d);
            padding: 12px 25px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15);
        }

        .navbar-container {
            max-width: 1400px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .brand {
            color: white;
            text-decoration: none;
            font-size: 24px;
            font-weight: bold;
            white-space: nowrap;
        }

            .brand span {
                color: #bbf7d0;
            }

            .brand:hover {
                color: white;
                text-decoration: none;
            }

        .nav-links {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 5px;
        }

            .nav-links a {
                color: white;
                text-decoration: none;
                padding: 8px 11px;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 600;
                transition: 0.2s;
            }

                .nav-links a:hover {
                    background: rgba(255, 255, 255, 0.15);
                    color: white;
                    text-decoration: none;
                }

        /* WORKER BUTTONS */
        .nav-btn {
            color: white !important;
            text-decoration: none !important;
            padding: 8px 11px;
            margin-left: 2px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            transition: 0.2s;
        }

            .nav-btn:hover {
                color: white !important;
                background: rgba(255, 255, 255, 0.15);
                text-decoration: none !important;
            }

        /* LANGUAGE */
        .language-box {
            margin-left: 5px;
        }

        .language-select {
            background: white;
            color: #14532d;
            border: none;
            border-radius: 7px;
            padding: 7px 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            outline: none;
        }

            .language-select option {
                color: #14532d;
                background: white;
            }

        /* PAGE */
        .main-content {
            min-height: calc(100vh - 150px);
            padding-bottom: 30px;
        }

        /* FOOTER */
        .eco-footer {
            background: #14532d;
            color: white;
            padding: 25px 15px;
            text-align: center;
            margin-top: 30px;
        }

            .eco-footer p {
                margin: 5px 0;
            }

            .eco-footer a {
                color: #bbf7d0;
                text-decoration: none;
            }

                .eco-footer a:hover {
                    color: white;
                    text-decoration: underline;
                }

        /* MOBILE */
        @@media (max-width: 900px) {

            .navbar-container {
                flex-direction: column;
                align-items: center;
            }

            .nav-links {
                justify-content: center;
            }

            .brand {
                font-size: 22px;
            }
        }

        @@media (max-width: 500px) {

            .eco-navbar {
                padding: 12px 10px;
            }

            .nav-links {
                gap: 2px;
            }

                .nav-links a,
                .nav-btn {
                    font-size: 12px;
                    padding: 6px 8px;
                }

            .language-select {
                font-size: 12px;
                padding: 6px 8px;
            }
        }
    </style>

</head>

<body>

    <!-- NAVBAR -->
    <nav class="eco-navbar">
        <div class="navbar-container">

            <!-- BRAND -->
            <a href="@Url.Action("Index", "Home")" class="brand">
                ♻️ Waste <span>Management</span>
            </a>

            <!-- NAVIGATION -->
            <div class="nav-links">

                <!-- HOME -->
                <a href="@Url.Action("Index", "Home")">
                    Home
                </a>

                <!-- ABOUT -->
                <a href="@Url.Action("About", "Home")">
                    About
                </a>

                <!-- CONTACT -->
                <a href="@Url.Action("Contact", "Home")">
                    Contact
                </a>

                <!-- LANGUAGE -->
                <div class="language-box">
                    <select class="language-select">
                        <option value="English">🌐 English</option>
                        <option value="Marathi">🇮🇳 मराठी</option>
                        <option value="Hindi">🇮🇳 हिंदी</option>
                    </select>
                </div>

                <!-- CITIZEN -->
                @if (Session["CitizenID"] == null)
                {
                    <a href="@Url.Action("Login", "Citizen")">
                        Citizen Login
                    </a>

                    <a href="@Url.Action("Register", "Citizen")">
                        Register
                    </a>
                }
                else
                {
                    <a href="@Url.Action("MyComplaints", "Waste")">
                        My Complaints
                    </a>

                    <a href="@Url.Action("Logout", "Citizen")">
                        Logout
                    </a>
                }

                <!-- WORKER -->
                @if (Session["WorkerID"] == null)
                {
                    <a href="@Url.Action("Login", "Worker")"
                       class="nav-btn">
                        Worker Login
                    </a>

                    <a href="@Url.Action("Register", "Worker")"
                       class="nav-btn">
                        Worker Register
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Dashboard", "Worker")"
                       class="nav-btn">
                        Worker Dashboard
                    </a>

                    <a href="@Url.Action("Logout", "Worker")"
                       class="nav-btn">
                        Worker Logout
                    </a>
                }

                <!-- ADMIN -->
                <a href="@Url.Action("Login", "Admin")">
                    Admin
                </a>

            </div>
        </div>
    </nav>


    <!-- MAIN CONTENT -->
    <div class="main-content">
        @RenderBody()
    </div>


    <!-- FOOTER -->y
    <footer class="eco-footer">

        <p>
            ♻️ <strong>Waste Management System</strong>
        </p>

        <p>
            Smart Waste Collection & Tracking System
        </p>

        <p>
            © @DateTime.Now.Year Waste Management System.
            All Rights Reserved.
        </p>

    </footer>


    <!-- SCRIPTS -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>