@model WasteManagementSystemMVC.Models.WasteComplaint

@{
    ViewBag.Title = "Complaint Tracking";
}

<div class="container mt-5 mb-5">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">Complaint Tracking</h3>
        </div>

        <div class="card-body">

            <!-- Complaint Information -->
            <div class="mb-4">

                <h4 class="text-primary">Complaint Information</h4>
                <hr />

                <p>
                    <strong>Complaint ID:</strong>
                    @Model.ComplaintID
                </p>

                <p>
                    <strong>Location:</strong>
                    @Model.Location
                </p>

                <p>
                    <strong>Waste Type:</strong>
                    @Model.WasteType
                </p>

                <p>
                    <strong>Description:</strong>
                    @Model.Description
                </p>

                <p>
                    <strong>Report Date:</strong>
                    @Model.ReportDate.ToString("dd-MM-yyyy hh:mm tt")
                </p>

            </div>


            <!-- Status Timeline -->
            <div class="mb-4">

                <h4 class="text-primary">Complaint Status</h4>
                <hr />

                <div class="status-timeline">

                    <!-- Pending -->
                    <div class="status-step @(Model.Status == "Pending" || Model.Status == "In Progress" || Model.Status == "Collected" || Model.Status == "Resolved" ? "completed" : "")">

                        <div class="status-circle">1</div>

                        <div class="status-label">
                            Pending
                        </div>

                    </div>


                    <div class="status-line @(Model.Status == "In Progress" || Model.Status == "Collected" || Model.Status == "Resolved" ? "completed-line" : "")">
                    </div>


                    <!-- In Progress -->
                    <div class="status-step @(Model.Status == "In Progress" || Model.Status == "Collected" || Model.Status == "Resolved" ? "completed" : "")">

                        <div class="status-circle">2</div>

                        <div class="status-label">
                            In Progress
                        </div>

                    </div>


                    <div class="status-line @(Model.Status == "Collected" || Model.Status == "Resolved" ? "completed-line" : "")">
                    </div>


                    <!-- Collected -->
                    <div class="status-step @(Model.Status == "Collected" || Model.Status == "Resolved" ? "completed" : "")">

                        <div class="status-circle">3</div>

                        <div class="status-label">
                            Collected
                        </div>

                    </div>


                    <div class="status-line @(Model.Status == "Resolved" ? "completed-line" : "")">
                    </div>


                    <!-- Resolved -->
                    <div class="status-step @(Model.Status == "Resolved" ? "completed" : "")">

                        <div class="status-circle">4</div>

                        <div class="status-label">
                            Resolved
                        </div>

                    </div>

                </div>

            </div>


            <!-- Current Status -->
            <div class="current-status">

                <strong>Current Status:</strong>

                <span>
                    @Model.Status
                </span>

            </div>

        </div>


        <!-- Buttons -->
        <div class="card-footer">

            <a href="@Url.Action("Track", "Waste")"
               class="btn btn-primary">
                Track Another Complaint
            </a>

            <a href="@Url.Action("MyComplaints", "Waste")"
               class="btn btn-secondary">
                My Complaints
            </a>

        </div>

    </div>

</div>


<style>

    .status-timeline {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 35px;
        margin-bottom: 30px;
        overflow-x: auto;
    }

    .status-step {
        text-align: center;
        min-width: 100px;
    }

    .status-circle {
        width: 50px;
        height: 50px;
        line-height: 50px;
        margin: auto;
        border-radius: 50%;
        background: #d6d6d6;
        color: #555;
        font-weight: bold;
        font-size: 18px;
    }

    .status-step.completed .status-circle {
        background: #087f8c;
        color: white;
    }

    .status-label {
        margin-top: 10px;
        font-weight: bold;
        color: #777;
    }

    .status-step.completed .status-label {
        color: #087f8c;
    }

    .status-line {
        width: 80px;
        height: 5px;
        background: #d6d6d6;
    }

    .completed-line {
        background: #087f8c;
    }

    .current-status {
        text-align: center;
        padding: 15px;
        background: #eefcff;
        border-radius: 10px;
        font-size: 18px;
    }

        .current-status span {
            margin-left: 10px;
            font-weight: bold;
            color: #087f8c;
        }
</style>