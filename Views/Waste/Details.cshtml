@model WasteManagementSystemMVC.Models.WasteComplaint

@{
    ViewBag.Title = "Complaint Details";
}

<div class="container mt-5 mb-5">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">Complaint Details</h3>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Complaint ID</strong>
                </div>
                <div class="col-md-8">
                    @Model.ComplaintID
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Name</strong>
                </div>
                <div class="col-md-8">
                    @Model.Name
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Location</strong>
                </div>
                <div class="col-md-8">
                    @Model.Location
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Waste Type</strong>
                </div>
                <div class="col-md-8">
                    @Model.WasteType
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Description</strong>
                </div>
                <div class="col-md-8">
                    @Model.Description
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Report Date</strong>
                </div>
                <div class="col-md-8">
                    @Model.ReportDate.ToString("dd-MM-yyyy hh:mm tt")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Status</strong>
                </div>
                <div class="col-md-8">
                    <span class="badge bg-success">
                        @Model.Status
                    </span>
                </div>
            </div>

        </div>

        <div class="card-footer">

            <a href="@Url.Action("MyComplaints", "Waste")"
               class="btn btn-secondary">
                ← Back to My Complaints
            </a>

        </div>

    </div>

</div>