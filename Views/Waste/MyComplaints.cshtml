@model IEnumerable<WasteManagementSystemMVC.Models.WasteComplaint>
@using System.Linq

@{
    ViewBag.Title = "My Complaints";
}

<div class="container mt-4">

    @if (ViewBag.ResolutionMessage != null)
    {
        <div class="alert alert-success text-center shadow-sm">
            <strong>✓ Notification</strong>
            <br />
            @ViewBag.ResolutionMessage
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["ErrorMessage"]
        </div>
    }

    <h2 class="text-center mb-4">
        My Complaints
    </h2>

    @if (Model == null || Model.Count() == 0)
    {
        <div class="alert alert-info text-center">
            You have not submitted any waste complaints yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-success">

                    <tr>
                        <th>Complaint ID</th>
                        <th>Location</th>
                        <th>Waste Type</th>
                        <th>Description</th>
                        <th>Report Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var complaint in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    #@complaint.ComplaintID
                                </strong>
                            </td>

                            <td>
                                @complaint.Location
                            </td>

                            <td>
                                @complaint.WasteType
                            </td>

                            <td>
                                @complaint.Description
                            </td>

                            <td>
                                @complaint.ReportDate.ToString("dd-MM-yyyy hh:mm tt")
                            </td>

                            <td>

                                @if (complaint.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (complaint.Status == "In Progress")
                                {
                                    <span class="badge bg-primary">
                                        In Progress
                                    </span>
                                }
                                else if (complaint.Status == "Collected")
                                {
                                    <span class="badge bg-success">
                                        Collected
                                    </span>
                                }
                                else if (complaint.Status == "Resolved")
                                {
                                    <span class="badge bg-success">
                                        Resolved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @complaint.Status
                                    </span>
                                }

                            </td>

                            <td>

                                <a href="@Url.Action("Details", "Waste", new { id = complaint.ComplaintID })"
                                   class="btn btn-info btn-sm mb-1">
                                    View Details
                                </a>

                                @if (complaint.Status == "Resolved")
                                {
                                    <br />

                                    <a href="@Url.Action("Create", "Feedback", new { complaintId = complaint.ComplaintID })"
                                       class="btn btn-warning btn-sm mt-1">
                                        ⭐ Give Feedback
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="text-center mt-3">

        <a href="@Url.Action("Report", "Waste")"
           class="btn btn-success">
            Report New Waste
        </a>

        <a href="@Url.Action("Index", "Home")"
           class="btn btn-secondary">
            Back to Home
        </a>

    </div>

</div>