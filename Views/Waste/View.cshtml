@{
    ViewBag.Title = "Track Complaint";
}

<div class="track-container">
    <div class="track-card">
        <div class="track-icon">📍</div>

        <h2>Track Your Complaint</h2>

        <p>Enter your Complaint ID to check the current status.</p>

        @using (Html.BeginForm("Track", "Waste", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="complaintId">Complaint ID</label>

                <input type="number"
                       id="complaintId"
                       name="complaintId"
                       class="form-control"
                       placeholder="Enter Complaint ID"
                       required />
            </div>

            <button type="submit" class="track-btn">
                Check Status
            </button>
        }

        <a href="@Url.Action("Index", "Home")" class="back-link">
            ← Back to Home
        </a>
    </div>
</div>

<style>
    .track-container {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: #eefcff;
    }

    .track-card {
        width: 100%;
        max-width: 500px;
        padding: 40px;
        text-align: center;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 80, 100, 0.15);
    }

    .track-icon {
        font-size: 45px;
        margin-bottom: 15px;
    }

    .track-card h2 {
        color: #075985;
        margin-bottom: 10px;
    }

    .track-card p {
        color: #555;
        margin-bottom: 25px;
    }

    .form-group {
        text-align: left;
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #164e63;
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #b7dfe8;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .track-btn {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 25px;
        background: #087f8c;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

        .track-btn:hover {
            background: #055b63;
        }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #075985;
        text-decoration: none;
    }
</style>