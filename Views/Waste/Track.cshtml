@{
    ViewBag.Title = "Track Complaint";
}

<div class="container mt-5 mb-5">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">Track Your Waste Complaint</h3>
        </div>

        <div class="card-body">

            <p class="text-muted">
                Enter your Complaint ID to check the current status of your complaint.
            </p>
           

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }

            @using (Html.BeginForm("Track", "Waste", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">

                    <label for="complaintId">
                        <strong>Complaint ID</strong>
                    </label>

                    <input type="number"
                           id="complaintId"
                           name="complaintId"
                           class="form-control"
                           placeholder="Enter Complaint ID"
                           required />

                </div>

                <button type="submit" class="btn btn-primary">
                    Track Complaint
                </button>

                <a href="@Url.Action("MyComplaints", "Waste")"
                   class="btn btn-secondary">
                    My Complaints
                </a>

            }

        </div>

    </div>

</div>