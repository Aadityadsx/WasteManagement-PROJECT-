@{
    ViewBag.Title = "Complaint Submitted";
}

<div class="success-container">
    <div class="success-card">
        <div class="success-icon">✓</div>

        <h2>Complaint Submitted Successfully!</h2>

        <p>
            Thank you for reporting the waste issue.
            Our waste collection team will review your complaint.
        </p>

        <a href="@Url.Action("Index", "Home")" class="success-btn">
            Back to Home
        </a>

        <a href="@Url.Action("Report", "Waste")" class="success-btn secondary">
            Report Another Complaint
        </a>
    </div>
</div>

<style>
    .success-container {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: #eefcff;
    }

    .success-card {
        max-width: 550px;
        width: 100%;
        text-align: center;
        padding: 45px 30px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 80, 100, 0.15);
    }

    .success-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #16a085;
        color: white;
        font-size: 50px;
        line-height: 75px;
    }

    .success-card h2 {
        color: #075985;
        margin-bottom: 15px;
    }

    .success-card p {
        color: #555;
        margin-bottom: 30px;
    }

    .success-btn {
        display: inline-block;
        margin: 5px;
        padding: 12px 20px;
        border-radius: 25px;
        background: #087f8c;
        color: white;
        text-decoration: none;
    }

        .success-btn:hover {
            background: #055b63;
            color: white;
        }

        .success-btn.secondary {
            background: #164e63;
        }
</style>