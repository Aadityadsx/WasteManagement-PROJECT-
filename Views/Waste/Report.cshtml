@model WasteManagementSystemMVC.Models.WasteComplaint

@{
    ViewBag.Title = "Report Waste";
}

<div class="container" style="max-width:850px; margin-top:40px; margin-bottom:50px;">
    <div class="card shadow-lg" style="border-radius:20px; overflow:hidden;">
        <div style="background:linear-gradient(135deg,#0f766e,#16a34a); color:white; padding:25px;">
            <h2 style="margin:0;">♻️ Report Waste</h2>
            <p style="margin:8px 0 0;">
                Report a waste problem in your area.
            </p>
        </div>

        <div style="padding:30px;">

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }

            @using (Html.BeginForm("Report", "Waste", FormMethod.Post, new { id = "reportForm" }))
            {
                @Html.AntiForgeryToken()

                <!-- NAME -->

                <div class="form-group" style="margin-bottom:20px;">
                    <label>Name</label>

                    @Html.TextBoxFor(m => m.Name, new
                    {
                        @class = "form-control",
                        placeholder = "Enter your name"
                    })
                </div>


                <!-- LOCATION -->

                <div class="form-group" style="margin-bottom:20px;">
                    <label>Location</label>

                    @Html.TextBoxFor(m => m.Location, new
                    {
                        @class = "form-control",
                        placeholder = "Enter waste location"
                    })
                </div>


                <!-- WASTE TYPE -->

                <div class="form-group" style="margin-bottom:20px;">
                    <label>Waste Type</label>

                    @Html.DropDownListFor(
                             m => m.WasteType,
                             new SelectList(new[]
                             {
                        "Household Waste",
                        "Plastic Waste",
                        "Paper Waste",
                        "Food Waste",
                        "Electronic Waste",
                        "Construction Waste",
                        "Medical Waste",
                        "Garden Waste",
                        "Mixed Waste",
                        "Other"
                         }),
                             "Select Waste Type",
                             new
                             {
                                 @class = "form-control"
                             })
                </div>


                <!-- DESCRIPTION -->

                <div class="form-group" style="margin-bottom:20px;">
                    <label>Description</label>

                    @Html.TextAreaFor(m => m.Description, new
                    {
                        @class = "form-control",
                        rows = "5",
                        placeholder = "Describe the waste problem"
                    })
                </div>


                <hr style="margin:30px 0;" />


                <!-- GPS -->

                <h4 style="color:#166534;">
                    📍 Complaint Location
                </h4>

                <p style="color:#666;">
                    Click the button below to capture your current GPS location.
                </p>


                <button type="button"
                        id="getLocationButton"
                        class="btn btn-success"
                        style="margin-bottom:15px;">

                    📍 Capture My Location

                </button>


                <div id="locationMessage"
                     style="margin-bottom:15px; font-weight:bold;">
                </div>


                <!-- HIDDEN GPS VALUES -->

                @Html.HiddenFor(
                         m => m.Latitude,
                         new { id = "Latitude" }
                     )

                @Html.HiddenFor(
                         m => m.Longitude,
                         new { id = "Longitude" }
                     )


                <!-- SUBMIT -->

                <button type="submit"
                        class="btn btn-primary btn-lg"
                        style="width:100%; margin-top:20px;">

                    Submit Complaint

                </button>

            }

        </div>

    </div>
</div>
<script>document.getElementById("getLocationButton").addEventListener("click", function () { var message = document.getElementById("locationMessage"); message.innerHTML = "Getting your location..."; if (!navigator.geolocation) { message.innerHTML = "GPS is not supported by this browser."; message.style.color = "red"; return; } navigator.geolocation.getCurrentPosition( function (position) { document.getElementById("Latitude").value = position.coords.latitude; document.getElementById("Longitude").value = position.coords.longitude; message.innerHTML = "✓ Location captured successfully"; message.style.color = "green"; }, function (error) { message.innerHTML = "Unable to capture location. Please allow location permission."; message.style.color = "red"; } ); });</script>