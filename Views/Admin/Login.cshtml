@{
    ViewBag.Title = "Admin Login";
}

<div class="login-container">
    <div class="login-card">
        <div class="login-icon">🔐</div>

        <h2>Admin Login</h2>
        <p>Sign in to manage waste complaints</p>

        @using (Html.BeginForm("Login", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="username">Username</label>
                <input type="text"
                       id="username"
                       name="username"
                       class="form-control"
                       placeholder="Enter username"
                       required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password"
                       id="password"
                       name="password"
                       class="form-control"
                       placeholder="Enter password"
                       required />
            </div>

            if (ViewBag.ErrorMessage != null)
            {
                <p class="error-message">@ViewBag.ErrorMessage</p>
            }

            <button type="submit" class="login-btn">
                Login
            </button>
        }

        <a href="@Url.Action("Index", "Home")" class="back-link">
            ← Back to Home
        </a>
    </div>
</div>

<style>
    .login-container {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 35px 20px;
        background: #eefcff;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        padding: 35px;
        background: white;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 10px 35px rgba(0, 80, 100, 0.15);
    }

    .login-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    .login-card h2 {
        color: #075985;
        margin-bottom: 8px;
    }

    .login-card p {
        color: #555;
    }

    .form-group {
        text-align: left;
        margin-top: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #164e63;
            font-weight: bold;
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #b7dfe8;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .login-btn {
        width: 100%;
        margin-top: 25px;
        padding: 13px;
        border: none;
        border-radius: 25px;
        background: #087f8c;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

        .login-btn:hover {
            background: #055b63;
        }

    .error-message {
        color: #dc2626 !important;
        margin-top: 15px;
    }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #075985;
        text-decoration: none;
    }
</style>
```
