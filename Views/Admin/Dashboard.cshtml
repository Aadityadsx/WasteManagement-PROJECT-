@model IEnumerable<WasteManagementSystemMVC.Models.WasteComplaint>
@using System.Linq

@{
    ViewBag.Title = "Admin Dashboard";
    var workers = ViewBag.Workers as IEnumerable<WasteManagementSystemMVC.Models.Worker>;
    var feedbacks = ViewBag.Feedbacks as IEnumerable<WasteManagementSystemMVC.Models.Feedback>;
}

<div class="container" style="margin-top:40px; margin-bottom:50px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
        <div> <h1 style="color:#1b5e20; margin-bottom:5px;"> ♻️ Admin Dashboard </h1> <p style="color:#666;"> Manage waste complaints and assign workers </p> </div>

        <a href="@Url.Action("Logout", "Admin")"
           class="btn btn-danger">
            Logout
        </a>
    </div>


    <!-- STATISTICS -->

    <div class="row">

        <div class="col-md-3">
            <div class="card shadow-sm"
                 style="padding:20px; margin-bottom:20px; border-radius:15px;">
                <h5>Total Complaints</h5>
                <h2 style="color:#1b5e20;">
                    @ViewBag.TotalComplaints
                </h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm"
                 style="padding:20px; margin-bottom:20px; border-radius:15px;">
                <h5>Pending</h5>
                <h2 style="color:#f57c00;">
                    @ViewBag.PendingComplaints
                </h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm"
                 style="padding:20px; margin-bottom:20px; border-radius:15px;">
                <h5>In Progress</h5>
                <h2 style="color:#1976d2;">
                    @ViewBag.InProgressComplaints
                </h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm"
                 style="padding:20px; margin-bottom:20px; border-radius:15px;">
                <h5>Resolved</h5>
                <h2 style="color:#2e7d32;">
                    @ViewBag.ResolvedComplaints
                </h2>
            </div>
        </div>

    </div>


    <!-- FEEDBACK STATISTICS -->

    <div class="row" style="margin-top:10px;">

        <div class="col-md-6">
            <div class="card shadow-sm"
                 style="padding:20px; margin-bottom:20px; border-radius:15px;">
                <h5>⭐ Total Feedbacks</h5>
                <h2 style="color:#1b5e20;">
                    @ViewBag.TotalFeedbacks
                </h2>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm"
                 style="padding:20px; margin-bottom:20px; border-radius:15px;">
                <h5>⭐ Average Rating</h5>
                <h2 style="color:#f57c00;">
                    @(Convert.ToDouble(ViewBag.AverageRating).ToString("0.0")) / 5
                </h2>
            </div>
        </div>

    </div>


    <!-- COMPLAINTS -->

    <div class="card shadow-sm"
         style="padding:25px; margin-top:20px; border-radius:15px;">

        <h3 style="color:#1b5e20; margin-bottom:25px;">
            📋 Waste Complaints
        </h3>

        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead style="background:#e8f5e9;">

                    <tr>
                        <th>ID</th>
                        <th>Citizen</th>
                        <th>Location</th>
                        <th>Waste Type</th>
                        <th>Status</th>
                        <th>Assign Worker</th>
                        <th>Update Status</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var complaint in Model)
                    {
                        <tr>

                            <td>
                                @complaint.ComplaintID
                            </td>

                            <td>
                                @complaint.Name
                            </td>

                            <td>
                                @complaint.Location
                            </td>

                            <td>
                                @complaint.WasteType
                            </td>

                            <td>
                                <strong>
                                    @complaint.Status
                                </strong>
                            </td>

                            <!-- ASSIGN WORKER -->

                            <td>

                                @using (Html.BeginForm(
                                    "AssignWorker",
                                    "Admin",
                                    FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="complaintId"
                                           value="@complaint.ComplaintID" />

                                    <select name="workerId"
                                            class="form-control"
                                            required>

                                        <option value="">
                                            Select Worker
                                        </option>

                                        @if (workers != null)
                                        {
                                            foreach (var worker in workers)
                                            {
                                                <option value="@worker.WorkerID"
                                                        @(complaint.WorkerID == worker.WorkerID ? "selected" : "")>

                                                    @worker.FullName

                                                </option>
                                            }
                                        }

                                    </select>

                                    <button type="submit"
                                            class="btn btn-success btn-sm"
                                            style="margin-top:8px; width:100%;">

                                        Assign

                                    </button>
                                }

                            </td>


                            <!-- UPDATE STATUS -->

                            <td>

                                @using (Html.BeginForm(
                                    "UpdateStatus",
                                    "Admin",
                                    FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="complaintId"
                                           value="@complaint.ComplaintID" />

                                    <select name="status"
                                            class="form-control">

                                        <option value="Pending"
                                                @(complaint.Status == "Pending" ? "selected" : "")>
                                            Pending
                                        </option>

                                        <option value="In Progress"
                                                @(complaint.Status == "In Progress" ? "selected" : "")>
                                            In Progress
                                        </option>

                                        <option value="Collected"
                                                @(complaint.Status == "Collected" ? "selected" : "")>
                                            Collected
                                        </option>

                                        <option value="Resolved"
                                                @(complaint.Status == "Resolved" ? "selected" : "")>
                                            Resolved
                                        </option>

                                    </select>

                                    <button type="submit"
                                            class="btn btn-primary btn-sm"
                                            style="margin-top:8px; width:100%;">

                                        Update

                                    </button>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- FEEDBACK -->

    <div class="card shadow-sm"
         style="padding:25px; margin-top:25px; border-radius:15px;">

        <h3 style="color:#1b5e20; margin-bottom:25px;">
            ⭐ Citizen Feedback
        </h3>

        @if (feedbacks == null || feedbacks.Count() == 0)
        {
            <div class="alert alert-info">
                No feedback has been submitted yet.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead style="background:#fff3cd;">

                        <tr>
                            <th>Feedback ID</th>
                            <th>Complaint ID</th>
                            <th>Citizen ID</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Date</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var feedback in feedbacks)
                        {
                            <tr>

                                <td>
                                    @feedback.FeedbackID
                                </td>

                                <td>
                                    #@feedback.ComplaintID
                                </td>

                                <td>
                                    @feedback.CitizenID
                                </td>

                                <td>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= feedback.Rating)
                                        {
                                            <span>⭐</span>
                                        }
                                        else
                                        {
                                            <span>☆</span>
                                        }
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(feedback.Comments)
                                    ? "No comments"
                                    : feedback.Comments)
                                </td>

                                <td>
                                    @feedback.FeedbackDate.ToString("dd-MM-yyyy hh:mm tt")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>