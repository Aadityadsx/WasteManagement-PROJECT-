@model IEnumerable<WasteManagementSystemMVC.Models.WasteComplaint>

@{
    ViewBag.Title = "Worker Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>👷 Worker Dashboard</h2>
            <p class="text-muted">
                Welcome, <strong>@Session["WorkerName"]</strong>
            </p>
        </div>

        <a href="@Url.Action("Logout", "Worker")"
           class="btn btn-danger">
            Logout
        </a>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- STATISTICS -->

    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6>Total Assigned</h6>
                    <h2>@ViewBag.TotalComplaints</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6>Pending</h6>
                    <h2>@ViewBag.PendingComplaints</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6>In Progress</h6>
                    <h2>@ViewBag.InProgressComplaints</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6>Collected</h6>
                    <h2>@ViewBag.CollectedComplaints</h2>
                </div>
            </div>
        </div>

    </div>


    <!-- COMPLAINTS -->

    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Assigned Complaints</h4>
        </div>

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    No complaints have been assigned to you yet.
                </div>
            }
            else
            {

                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-success">

                            <tr>
                                <th>Complaint ID</th>
                                <th>Citizen Name</th>
                                <th>Location</th>
                                <th>Waste Type</th>
                                <th>Description</th>
                                <th>Report Date</th>
                                <th>Status</th>
                                <th>GPS Verification</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var complaint in Model)
                            {

                                <tr>

                                    <td>
                                        <strong>
                                            #@complaint.ComplaintID
                                        </strong>
                                    </td>


                                    <td>
                                        @complaint.Name
                                    </td>


                                    <td>
                                        @complaint.Location
                                    </td>


                                    <td>
                                        @complaint.WasteType
                                    </td>


                                    <td>
                                        @complaint.Description
                                    </td>


                                    <td>
                                        @complaint.ReportDate.ToString("dd-MM-yyyy HH:mm")
                                    </td>


                                    <td>

                                        @if (complaint.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (complaint.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else if (complaint.Status == "Collected")
                                        {
                                            <span class="badge bg-success">
                                                Collected
                                            </span>
                                        }
                                        else if (complaint.Status == "Resolved")
                                        {
                                            <span class="badge bg-success">
                                                Resolved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @complaint.Status
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (complaint.LocationVerified)
                                        {

                                            <div class="alert alert-success p-2 mb-0">

                                                <strong>✓ GPS Verified</strong>

                                                @if (complaint.WorkerLatitude.HasValue &&
                                                     complaint.WorkerLongitude.HasValue)
                                                {
                                                    <br />

                                                    <small>
                                                        Worker Location:
                                                        @complaint.WorkerLatitude.Value.ToString("F6"),
                                                        @complaint.WorkerLongitude.Value.ToString("F6")
                                                    </small>
                                                }

                                            </div>

                                        }
                                        else
                                        {

                                            <form action="@Url.Action("VerifyLocation", "Worker")"
                                                  method="post"
                                                  id="gpsForm_@complaint.ComplaintID">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="complaintId"
                                                       value="@complaint.ComplaintID" />

                                                <input type="hidden"
                                                       name="workerLatitude"
                                                       id="latitude_@complaint.ComplaintID"
                                                       value="" />

                                                <input type="hidden"
                                                       name="workerLongitude"
                                                       id="longitude_@complaint.ComplaintID"
                                                       value="" />

                                                <button type="button"
                                                        class="btn btn-success btn-sm gps-button"
                                                        style="width:100%;"
                                                        data-complaint-id="@complaint.ComplaintID">

                                                    📍 Verify GPS & Collect

                                                </button>

                                            </form>


                                            <div id="gpsStatus_@complaint.ComplaintID"
                                                 class="small text-muted mt-2">

                                                GPS verification required

                                            </div>

                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>


<script type="text/javascript">

        document.addEventListener("DOMContentLoaded", function () {

            var buttons = document.querySelectorAll(".gps-button");

            for (var i = 0; i < buttons.length; i++) {

                buttons[i].addEventListener("click", function () {

                    var complaintId =
                        this.getAttribute("data-complaint-id");

                    getWorkerLocation(complaintId);

                });

            }

        });


        function getWorkerLocation(complaintId) {

            var statusElement =
                document.getElementById("gpsStatus_" + complaintId);

            if (!navigator.geolocation) {

                alert("GPS is not supported by this browser.");

                return;
            }


            if (statusElement) {

                statusElement.innerHTML =
                    "Getting your current location...";

            }


            navigator.geolocation.getCurrentPosition(

                function (position) {

                    var latitude =
                        position.coords.latitude;

                    var longitude =
                        position.coords.longitude;


                    var latitudeField =
                        document.getElementById(
                            "latitude_" + complaintId
                        );


                    var longitudeField =
                        document.getElementById(
                            "longitude_" + complaintId
                        );


                    var form =
                        document.getElementById(
                            "gpsForm_" + complaintId
                        );


                    if (latitudeField &&
                        longitudeField &&
                        form) {

                        latitudeField.value =
                            latitude;

                        longitudeField.value =
                            longitude;


                        if (statusElement) {

                            statusElement.innerHTML =
                                "Location found. Verifying GPS...";

                        }


                        form.submit();

                    }
                    else {

                        alert(
                            "GPS form could not be found."
                        );

                    }

                },


                function (error) {

                    if (statusElement) {

                        statusElement.innerHTML =
                            "Unable to get location.";

                    }


                    if (error.code === 1) {

                        alert(
                            "Location permission was denied. Please allow location access."
                        );

                    }
                    else if (error.code === 2) {

                        alert(
                            "Unable to get your current location."
                        );

                    }
                    else if (error.code === 3) {

                        alert(
                            "GPS request timed out. Please try again."
                        );

                    }
                    else {

                        alert(
                            "Unable to get your location."
                        );

                    }

                },


                {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                }

            );

        }

</script>