@{
    ViewBag.Title = "Give Feedback";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow">

                <div class="card-header bg-success text-white text-center">

                    <h3 class="mb-0">
                        ⭐ Give Your Feedback
                    </h3>

                </div>

                <div class="card-body">

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    <p class="text-center text-muted">
                        How satisfied are you with the waste collection service?
                    </p>

                    <form method="post"
                          action="@Url.Action("Create", "Feedback")">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="complaintId"
                               value="@ViewBag.ComplaintID" />

                        <div class="text-center mb-4">

                            <label class="form-label d-block">
                                <strong>Rating</strong>
                            </label>

                            <div>

                                <label class="me-2">
                                    <input type="radio"
                                           name="rating"
                                           value="1"
                                           required />
                                    ⭐
                                </label>

                                <label class="me-2">
                                    <input type="radio"
                                           name="rating"
                                           value="2" />
                                    ⭐⭐
                                </label>

                                <label class="me-2">
                                    <input type="radio"
                                           name="rating"
                                           value="3" />
                                    ⭐⭐⭐
                                </label>

                                <label class="me-2">
                                    <input type="radio"
                                           name="rating"
                                           value="4" />
                                    ⭐⭐⭐⭐
                                </label>

                                <label>
                                    <input type="radio"
                                           name="rating"
                                           value="5" />
                                    ⭐⭐⭐⭐⭐
                                </label>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                <strong>Your Comments</strong>
                            </label>

                            <textarea name="comments"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Tell us about your experience..."></textarea>

                        </div>

                        <div class="text-center">

                            <button type="submit"
                                    class="btn btn-success px-5">

                                Submit Feedback

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>