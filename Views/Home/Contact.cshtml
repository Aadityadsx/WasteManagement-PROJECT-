@{
    ViewBag.Title = "Contact Us";
}

<div class="container mt-5 mb-5">

    ```
    <!-- Header -->
    <div class="text-center mb-5">

        <div style="font-size: 55px;">📞</div>

        <h1 class="fw-bold text-success">
            Contact Us
        </h1>

        <p class="text-muted fs-5">
            Have a question or need help? We're here to help.
        </p>

    </div>

    <div class="row g-4">

        <!-- Contact Information -->
        <div class="col-md-5">

            <div class="card shadow-lg border-0 h-100">

                <div class="card-body p-4 p-md-5">

                    <h2 class="text-success fw-bold mb-4">
                        🌱 Get In Touch
                    </h2>

                    <p class="text-muted mb-4">
                        If you have questions about reporting waste,
                        tracking complaints or using the system,
                        you can contact us using the information below.
                    </p>

                    <!-- Email -->
                    <div class="d-flex mb-4">

                        <div style="font-size: 30px;" class="me-3">
                            📧
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Email
                            </h5>

                            <p class="text-muted mb-0">
                                support@wastemanagement.com
                            </p>
                        </div>

                    </div>

                    <!-- Phone -->
                    <div class="d-flex mb-4">

                        <div style="font-size: 30px;" class="me-3">
                            📱
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Phone
                            </h5>

                            <p class="text-muted mb-0">
                                +91 98765 43210
                            </p>
                        </div>

                    </div>

                    <!-- Location -->
                    <div class="d-flex mb-4">

                        <div style="font-size: 30px;" class="me-3">
                            📍
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Location
                            </h5>

                            <p class="text-muted mb-0">
                                Local Municipal Office
                            </p>
                        </div>

                    </div>

                    <!-- Working Hours -->
                    <div class="d-flex">

                        <div style="font-size: 30px;" class="me-3">
                            🕒
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Working Hours
                            </h5>

                            <p class="text-muted mb-0">
                                Monday - Saturday<br />
                                9:00 AM - 6:00 PM
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Contact Form -->
        <div class="col-md-7">

            <div class="card shadow-lg border-0">

                <div class="card-body p-4 p-md-5">

                    <h2 class="text-success fw-bold mb-4">
                        ✉️ Send Us a Message
                    </h2>

                    <form>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Your Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter your name" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Email Address
                            </label>

                            <input type="email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Subject
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter subject" />

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Message
                            </label>

                            <textarea class="form-control"
                                      rows="6"
                                      placeholder="Write your message here..."></textarea>

                        </div>

                        <div class="text-center">

                            <button type="button"
                                    class="btn btn-success px-5 py-2">
                                📩 Send Message
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <!-- FAQ / Help -->
    <div class="card shadow-sm border-0 mt-5">

        <div class="card-body p-4 text-center">

            <h3 class="text-success fw-bold">
                ♻️ Need Help With a Complaint?
            </h3>

            <p class="text-muted">
                You can report waste and track your complaint directly
                from the Waste Management System.
            </p>

            <a href="@Url.Action("Report", "Waste")"
               class="btn btn-success me-2">
                📝 Report Waste
            </a>

            <a href="@Url.Action("Track", "Waste")"
               class="btn btn-outline-success">
                📍 Track Complaint
            </a>

        </div>

    </div>
    ```

</div>
