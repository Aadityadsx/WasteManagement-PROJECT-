@{
    ViewBag.Title = "About Us";
}

<div class="container mt-5 mb-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <div style="font-size: 55px;">♻️</div>

        <h1 class="fw-bold text-success">
            About Our Waste Management System
        </h1>

        <p class="text-muted fs-5">
            Smart Waste Management for a Cleaner and Greener Community
        </p>
    </div>

    <!-- Introduction -->
    <div class="card shadow-lg border-0 mb-4">
        <div class="card-body p-4 p-md-5">

            <h2 class="text-success mb-3">
                🌱 Our Mission
            </h2>

            <p class="lead">
                The Waste Management Tracking System for Local Bodies is a
                web-based application designed to improve the process of
                reporting, tracking and resolving waste-related complaints.
            </p>

            <p>
                Citizens can report waste problems from their location,
                track the progress of their complaints and provide feedback
                after the complaint has been resolved. Administrators can
                manage complaints, assign workers and monitor the overall
                waste collection process.
            </p>

            <p class="mb-0">
                Our goal is to use technology to make waste management more
                organized, transparent and efficient while helping create
                cleaner and healthier communities.
            </p>

        </div>
    </div>

    <!-- Features -->
    <h2 class="text-center text-success fw-bold mb-4">
        🌿 What Our System Provides
    </h2>

    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body p-4">

                    <div style="font-size: 45px;">📝</div>

                    <h4 class="text-success mt-3">
                        Report Waste
                    </h4>

                    <p class="text-muted">
                        Citizens can easily report waste problems by
                        providing location, waste type and description.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body p-4">

                    <div style="font-size: 45px;">📍</div>

                    <h4 class="text-success mt-3">
                        Track Complaints
                    </h4>

                    <p class="text-muted">
                        Citizens can track the current status of their
                        complaints from reporting to resolution.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body p-4">

                    <div style="font-size: 45px;">👷</div>

                    <h4 class="text-success mt-3">
                        Worker Management
                    </h4>

                    <p class="text-muted">
                        Administrators can assign complaints to workers
                        and monitor their collection activities.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body p-4">

                    <div style="font-size: 45px;">📍</div>

                    <h4 class="text-success mt-3">
                        GPS Verification
                    </h4>

                    <p class="text-muted">
                        Worker location can be verified near the reported
                        waste location before collection is confirmed.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body p-4">

                    <div style="font-size: 45px;">⭐</div>

                    <h4 class="text-success mt-3">
                        Citizen Feedback
                    </h4>

                    <p class="text-muted">
                        Citizens can rate the waste collection service
                        and provide valuable comments.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body p-4">

                    <div style="font-size: 45px;">📊</div>

                    <h4 class="text-success mt-3">
                        Admin Dashboard
                    </h4>

                    <p class="text-muted">
                        Administrators can monitor complaints, workers,
                        statuses and citizen feedback from one dashboard.
                    </p>

                </div>
            </div>
        </div>

    </div>

    <!-- Complaint Flow -->
    <div class="card shadow-lg border-0 mb-5">

        <div class="card-body p-4 p-md-5">

            <h2 class="text-success text-center fw-bold mb-4">
                🔄 How The System Works
            </h2>

            <div class="row text-center">

                <div class="col-md-3 mb-4">
                    <div style="font-size: 40px;">📝</div>
                    <h5 class="fw-bold">1. Report</h5>
                    <p class="text-muted">
                        Citizen reports a waste problem.
                    </p>
                </div>

                <div class="col-md-3 mb-4">
                    <div style="font-size: 40px;">👷</div>
                    <h5 class="fw-bold">2. Assign</h5>
                    <p class="text-muted">
                        Admin assigns the complaint to a worker.
                    </p>
                </div>

                <div class="col-md-3 mb-4">
                    <div style="font-size: 40px;">🚛</div>
                    <h5 class="fw-bold">3. Collect</h5>
                    <p class="text-muted">
                        Worker collects the reported waste.
                    </p>
                </div>

                <div class="col-md-3 mb-4">
                    <div style="font-size: 40px;">✅</div>
                    <h5 class="fw-bold">4. Resolve</h5>
                    <p class="text-muted">
                        Complaint is resolved and citizen can give feedback.
                    </p>
                </div>

            </div>

        </div>

    </div>

    <!-- Technology -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h3 class="text-success fw-bold">
                💻 Technology Used
            </h3>

            <div class="row mt-3">

                <div class="col-md-3 mb-2">
                    <span class="badge bg-success fs-6 p-2">
                        ASP.NET MVC
                    </span>
                </div>

                <div class="col-md-3 mb-2">
                    <span class="badge bg-success fs-6 p-2">
                        C#
                    </span>
                </div>

                <div class="col-md-3 mb-2">
                    <span class="badge bg-success fs-6 p-2">
                        Entity Framework
                    </span>
                </div>

                <div class="col-md-3 mb-2">
                    <span class="badge bg-success fs-6 p-2">
                        SQL Server
                    </span>
                </div>

            </div>

        </div>

    </div>

    <!-- Footer Message -->
    <div class="text-center mt-5">

        <h4 class="text-success fw-bold">
            🌍 Together for a Cleaner Tomorrow
        </h4>

        <p class="text-muted">
            Small actions today can create a cleaner and greener future.
        </p>

    </div>

</div>