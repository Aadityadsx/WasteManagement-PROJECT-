@{
    ViewBag.Title = "Home";
}
<a href="@Url.Action("Login", "Admin")" class="btn btn-dark">
    Admin Login
</a>
<style>
    .hero {
        min-height: 500px;
        padding: 90px 8%;
        color: white;
        background: linear-gradient(120deg, #063b5c, #087e8b, #0e7490);
        position: relative;
        overflow: hidden;
    }

        .hero::after {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: rgba(103, 232, 249, 0.12);
            right: -100px;
            top: -100px;
        }

    .hero-content {
        max-width: 650px;
        position: relative;
        z-index: 1;
    }

    .hero h1 {
        font-size: 52px;
        font-weight: bold;
        line-height: 1.15;
        margin: 15px 0;
    }

        .hero h1 span {
            color: #67e8f9;
        }

    .hero p {
        font-size: 18px;
        line-height: 1.7;
        color: #e0f2fe;
    }

    .hero-buttons {
        margin-top: 30px;
    }

    .hero-btn {
        display: inline-block;
        padding: 14px 28px;
        border-radius: 30px;
        margin-right: 12px;
        font-weight: bold;
        transition: 0.3s;
    }

    .primary-btn {
        background: #22d3ee;
        color: #063b5c;
    }

    .secondary-btn {
        border: 1px solid white;
        color: white;
    }

    .hero-btn:hover {
        transform: translateY(-3px);
        text-decoration: none;
    }

    .section {
        padding: 70px 8%;
        background: #f0f9ff;
        text-align: center;
    }

    .section-label {
        color: #0891b2;
        font-weight: bold;
        letter-spacing: 3px;
        font-size: 13px;
    }

    .section h2 {
        font-size: 36px;
        color: #12304a;
        margin: 12px 0;
    }

    .section-description {
        color: #52718a;
        max-width: 600px;
        margin: auto;
        line-height: 1.7;
    }

    .service-cards {
        display: flex;
        justify-content: center;
        gap: 25px;
        flex-wrap: wrap;
        margin-top: 40px;
    }

    .service-card {
        background: white;
        width: 280px;
        padding: 30px;
        border-radius: 18px;
        text-align: left;
        box-shadow: 0 8px 25px rgba(8, 145, 178, 0.12);
        transition: 0.3s;
    }

        .service-card:hover {
            transform: translateY(-8px);
        }

    .service-icon {
        font-size: 35px;
        margin-bottom: 15px;
    }

    .service-card h3 {
        color: #12304a;
        font-size: 21px;
    }

    .service-card p {
        color: #52718a;
        line-height: 1.6;
    }

    .service-link {
        color: #0891b2;
        font-weight: bold;
    }

    .stats {
        background: linear-gradient(135deg, #062b49, #075985);
        color: white;
        padding: 45px 8%;
        display: flex;
        justify-content: space-around;
        text-align: center;
        flex-wrap: wrap;
        gap: 30px;
    }

    .stat h2 {
        color: #67e8f9;
        margin: 0;
        font-size: 32px;
    }

    .stat p {
        color: #bae6fd;
        margin-top: 8px;
    }

    .wave {
        height: 35px;
        background: #f0f9ff;
        border-radius: 50% 50% 0 0;
        margin-top: -15px;
        position: relative;
    }
</style>

<!-- HERO SECTION -->
<div class="hero">
    <div class="hero-content">

        <p>🌊 Together for a Cleaner Tomorrow</p>

        <h1>
            Waste Management
            <span>System</span>
        </h1>

        <p>
            Report waste, track collection, and help keep
            your community clean and green.
        </p>

        <div class="hero-buttons">

            <a href="@Url.Action("Report", "Waste")" class="hero-btn primary-btn">
    🗑️ Report Waste →
            </a>

            <a href="@Url.Action("Track", "Waste")" class="hero-btn secondary-btn">
                📍 Track Complaint →
            </a>

        </div>

    </div>
</div>
<div class="container mt-5 mb-5">

    <h2 class="text-center mb-4">Waste Management Statistics</h2>

    <div class="row text-center">

        <div class="col-md-3 mb-3">
            <div class="card shadow p-3">
                <h5>Total Complaints</h5>
                <h2>@ViewBag.TotalComplaints</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow p-3">
                <h5>Pending</h5>
                <h2>@ViewBag.PendingComplaints</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow p-3">
                <h5>In Progress</h5>
                <h2>@ViewBag.InProgressComplaints</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow p-3">
                <h5>Resolved</h5>
                <h2>@ViewBag.ResolvedComplaints</h2>
            </div>
        </div>

    </div>

</div>

<div class="wave"></div>

<!-- SERVICES SECTION -->
<div class="section">

    <div class="section-label">OUR SERVICES</div>

    <h2>How We Help</h2>

    <p class="section-description">
        Our platform makes waste management easier,
        faster and more transparent for everyone.
    </p>

    <div class="service-cards">

        <div class="service-card">
            <div class="service-icon">🗑️</div>
            <h3>Report Waste</h3>
            <p>Report uncollected waste from your area.</p>
            <a href="#" class="service-link">Learn More →</a>
        </div>

        <div class="service-card">
            <div class="service-icon">📍</div>
            <h3>Track Collection</h3>
            <p>Check the status of your waste complaint.</p>
            <a href="#" class="service-link">Learn More →</a>
        </div>

        <div class="service-card">
            <div class="service-icon">🌱</div>
            <h3>Clean Environment</h3>
            <p>Help create a cleaner and healthier community.</p>
            <a href="#" class="service-link">Learn More →</a>
        </div>

    </div>

</div>

<!-- STATS SECTION -->
<div class="stats">

    <div class="stat">
        <h2>1000+</h2>
        <p>Active Users</p>
    </div>

    <div class="stat">
        <h2>500+</h2>
        <p>Complaints Resolved</p>
    </div>

    <div class="stat">
        <h2>200+</h2>
        <p>Tons of Waste Collected</p>
    </div>

    <div class="stat">
        <h2>🌍</h2>
        <p>Cleaner Greener Tomorrow</p>
    </div>

</div>